# Copy this file to .env and fill in secrets locally. Never commit .env.
# Application version — base version; the patch segment is auto-incremented at
# runtime when the git commit hash changes (detected via git rev-parse HEAD, or
# a build-time fingerprint in Docker). Displayed in the UI and returned by
# /api/health and /api/ready as the runtime version.
APP_VERSION=0.1.0
# Session secret for signing auth tokens
AUTH_SECRET=
# Session timeout in milliseconds (default 30 min)
SESSION_TIMEOUT_MS=1800000
# WooCommerce store configuration (optional — leave blank if not using WooCommerce)
WOOCOMMERCE_STORE_URL="https://your-woocommerce-site.com"
# When set, product images are served from this URL so WooCommerce can download
# them directly (avoids WordPress media library upload requiring upload_files
# capability). The server must be publicly accessible.
# Example: SERVER_URL=https://ecomint.example.com
SERVER_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_VERSION=wc/v3
WOOCOMMERCE_EMAIL=
# WordPress Application Password for media library uploads (requires:
# WordPress user with upload_files capability + Application Passwords plugin
# or WP 5.6+ native support). Generate from Users → Your Profile →
# Application Passwords in WordPress admin. Required if using
# Strategy 2 (WordPress media library upload) instead of SERVER_URL.
WOOCOMMERCE_USERNAME=
WOOCOMMERCE_APP_PASSWORD=
# Optional: comma-separated list of Name:ID pairs for predefined WooCommerce product categories
# Shown in the editor Categories multiselect (for AliExpress supplier); assigned to products at publish time.
WOOCOMMERCE_PRODUCT_CATEGORIES="Electronics:17,Home:21"
# API server port — Express dev server and Docker container-internal port
PORT=8787
# Docker host-facing port (maps to container PORT). Override to avoid collisions.
HOST_PORT=8787
# Vite dev server port — the URL the browser opens during local development
VITE_DEV_PORT=5173
# Required Shopify Admin API token scopes: read_products, write_products,
# read_inventory, write_inventory, read_publications, write_publications
SHOPIFY_STORE_DOMAIN=cb1710-2.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOCATION_ID=
SHOPIFY_FEATURED_COLLECTION_ID=
# Optional: comma-separated list of Name:ID pairs for predefined Shopify custom collections
# Shown in the editor Collections multiselect; assigned to checked products at publish time.
SHOPIFY_COLLECTION_ID="Spirits:314155073588,Red Wine:285318578228,White Wine:285318545460"
# Source URL allowlist — if empty, all HTTPS hosts are allowed (subject to
# private-IP blocking). If set, comma-separated hostnames (e.g.
# "aliexpress.com,aliexpress.us,myshop.com"). For Vican Visions (AliExpress)
# imports, add "aliexpress.com" so source page retrieval works.
SOURCE_URL_ALLOWLIST=
PRODUCT_IMAGE_DIRECTORY=./productimage
DATABASE_PATH=./data/ecomint.db
LOG_DIRECTORY=./logs
MAX_IMPORT_ROWS=10000
SOURCE_REQUEST_TIMEOUT_MS=12000
SOURCE_MAX_REDIRECTS=3
SOURCE_MAX_RESPONSE_BYTES=5242880
SOURCE_CATALOG_ENDPOINT=/rest/V1/product/getAllProduct
SOURCE_CATALOG_MAX_RESPONSE_BYTES=52428800
SOURCE_DESCRIPTION_ENDPOINT=/rest/V1/product-description
IMAGE_REQUEST_TIMEOUT_MS=15000
IMAGE_MAX_REDIRECTS=3
IMAGE_MAX_BYTES=15728640
IMAGE_DOWNLOAD_CONCURRENCY=3
