# Copy this file to .env and fill in secrets locally. Never commit .env.
# Application version — displayed in the UI and returned by /api/health and /api/ready
APP_VERSION=0.1.0
# API server port — Express dev server and Docker container-internal port
PORT=8787
# Docker host-facing port (maps to container PORT). Override to avoid collisions.
HOST_PORT=8787
# Vite dev server port — the URL the browser opens during local development
VITE_DEV_PORT=5173
# Required Shopify Admin API token scopes: read_products, write_products,
# read_inventory, write_inventory, read_publications, write_publications
SHOPIFY_STORE_DOMAIN=cb1710-2.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOCATION_ID=
SHOPIFY_FEATURED_COLLECTION_ID=
SOURCE_URL_ALLOWLIST=
PRODUCT_IMAGE_DIRECTORY=./productimage
DATABASE_PATH=./data/ecomint.db
LOG_DIRECTORY=./logs
MAX_IMPORT_ROWS=10000
SOURCE_REQUEST_TIMEOUT_MS=12000
SOURCE_MAX_REDIRECTS=3
SOURCE_MAX_RESPONSE_BYTES=5242880
SOURCE_CATALOG_ENDPOINT=/rest/V1/product/getAllProduct
SOURCE_CATALOG_MAX_RESPONSE_BYTES=52428800
SOURCE_DESCRIPTION_ENDPOINT=/rest/V1/product-description
IMAGE_REQUEST_TIMEOUT_MS=15000
IMAGE_MAX_REDIRECTS=3
IMAGE_MAX_BYTES=15728640
IMAGE_DOWNLOAD_CONCURRENCY=3
