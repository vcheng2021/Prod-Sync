{
  "name": "ecomint-shopify-product-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "start:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "stop:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./stop.ps1",
    "build": "npm --prefix client run build && tsc -p server/tsconfig.json",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && npm --prefix client run typecheck",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sanitize-html": "^2.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/sanitize-html": "^2.16.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
